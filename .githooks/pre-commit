#!/usr/bin/env bash
# Pre-commit guard: block sensitive files and scan staged changes for secrets.
# Bypass (emergencies only): SKIP_HOOKS=1 git commit ...
set -euo pipefail

[ "${SKIP_HOOKS:-0}" = "1" ] && exit 0

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

# --- Hard blocklist: these must never be committed, even force-added -------
BLOCK_PATTERNS='^environments\.json$|^keys/|(^|/)\.env$|\.pem$|^cdk\.out/'
BLOCKED=$(echo "$STAGED" | grep -E "$BLOCK_PATTERNS" || true)
if [ -n "$BLOCKED" ]; then
  echo "COMMIT BLOCKED — sensitive file(s) staged:" >&2
  echo "$BLOCKED" | sed 's/^/  /' >&2
  echo "These stay local by design (account mapping, signing keys, synth output)." >&2
  echo "Unstage with: git restore --staged <file>" >&2
  exit 1
fi

# --- Secret scan with gitleaks (if installed) -------------------------------
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --verbose; then
    echo "COMMIT BLOCKED — gitleaks found potential secrets in staged changes." >&2
    echo "If it's a false positive, add a gitleaks:allow comment or .gitleaksignore entry." >&2
    exit 1
  fi
else
  echo "warning: gitleaks not installed; skipping secret scan (brew install gitleaks)" >&2
fi

exit 0
